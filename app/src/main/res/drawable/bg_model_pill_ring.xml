<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient android:startColor="#4285F4" android:centerColor="#9B51E0" android:endColor="#FF6B8B" android:angle="0" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/gemini_surface" />
            <padding android:left="12dp" android:top="6dp" android:right="12dp" android:bottom="6dp" />
        </shape>
    </item>
</layer-list>
