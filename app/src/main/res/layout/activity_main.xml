<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gemini_bg">

    <!-- Main Screen Content Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- C++ OpenGL ES 3.0 Native Renderer for Cosmic Nebula & 4-Point Star Shader -->
        <com.google.geminiclone.GeminiGLSurfaceView
            android:id="@+id/glSurfaceView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Main UI Overlay -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/uiContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fitsSystemWindows="true">

            <!-- Top Navigation Bar -->
            <LinearLayout
                android:id="@+id/topBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Drawer Hamburger Menu Button -->
                <FrameLayout
                    android:id="@+id/btnOpenDrawer"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_menu"
                        app:tint="@color/text_primary"
                        tools:ignore="ContentDescription" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvBrandTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gemini_title"
                    android:textColor="@color/text_primary"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- New Chat Button in Top Bar -->
                <FrameLayout
                    android:id="@+id/btnNewChat"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_circle_btn"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_new_chat"
                        app:tint="@color/text_primary"
                        tools:ignore="ContentDescription" />
                </FrameLayout>

                <!-- Model Selector Pill Button (Far Right) -->
                <LinearLayout
                    android:id="@+id/btnModelSelector"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_model_pill_ring"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tvModelName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/gemini_model_default"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                
            </LinearLayout>

            <!-- Active Chat RecyclerView (Takes over screen when conversation starts) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvChatMessages"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:clipToPadding="false"
                android:paddingTop="8dp"
                android:paddingBottom="16dp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/topBar"
                app:layout_constraintBottom_toTopOf="@id/inputPillContainer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Initial Hero Container (Star, Greeting, Suggestions) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/heroContainer"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintTop_toBottomOf="@id/topBar"
                app:layout_constraintBottom_toTopOf="@id/inputPillContainer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Greeting Section -->
                <LinearLayout
                    android:id="@+id/greetingLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="24dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintVertical_bias="0.45"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:id="@+id/tvGreetingStart"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/greeting_hola"
                        android:textColor="@color/text_primary"
                        android:textSize="32sp"
                        android:fontFamily="sans-serif-light" />

                    <!-- Gemini Signature Gradient Shimmering Text -->
                    <com.google.geminiclone.ShimmerTextView
                        android:id="@+id/tvGreetingShimmer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/greeting_question"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <!-- Suggestion Cards (Horizontal Scroll) -->
                <HorizontalScrollView android:visibility="gone"
                    android:id="@+id/scrollSuggestions"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:overScrollMode="never"
                    android:paddingHorizontal="16dp"
                    android:clipToPadding="false"
                    android:layout_marginBottom="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Suggestion 1: Crear imagen -->
                        <LinearLayout
                            android:id="@+id/cardSuggestion1"
                            android:layout_width="160dp"
                            android:layout_height="140dp"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:background="@drawable/bg_suggestion_card"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_palette"
                                tools:ignore="ContentDescription" />

                            <View
                                android:layout_width="1dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/suggestion_1_title"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/suggestion_1_desc"
                                android:textColor="@color/text_hint"
                                android:textSize="11sp"
                                android:maxLines="2"
                                android:ellipsize="end"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <!-- Suggestion 2: Escribir texto -->
                        <LinearLayout
                            android:id="@+id/cardSuggestion2"
                            android:layout_width="160dp"
                            android:layout_height="140dp"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:layout_marginStart="12dp"
                            android:background="@drawable/bg_suggestion_card"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_edit"
                                tools:ignore="ContentDescription" />

                            <View
                                android:layout_width="1dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/suggestion_2_title"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/suggestion_2_desc"
                                android:textColor="@color/text_hint"
                                android:textSize="11sp"
                                android:maxLines="2"
                                android:ellipsize="end"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <!-- Suggestion 3: Planear idea -->
                        <LinearLayout
                            android:id="@+id/cardSuggestion3"
                            android:layout_width="160dp"
                            android:layout_height="140dp"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:layout_marginStart="12dp"
                            android:background="@drawable/bg_suggestion_card"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_lightbulb"
                                tools:ignore="ContentDescription" />

                            <View
                                android:layout_width="1dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/suggestion_3_title"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/suggestion_3_desc"
                                android:textColor="@color/text_hint"
                                android:textSize="11sp"
                                android:maxLines="2"
                                android:ellipsize="end"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <!-- Suggestion 4: Explicar código -->
                        <LinearLayout
                            android:id="@+id/cardSuggestion4"
                            android:layout_width="160dp"
                            android:layout_height="140dp"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:layout_marginStart="12dp"
                            android:background="@drawable/bg_suggestion_card"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_code"
                                tools:ignore="ContentDescription" />

                            <View
                                android:layout_width="1dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/suggestion_4_title"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/suggestion_4_desc"
                                android:textColor="@color/text_hint"
                                android:textSize="11sp"
                                android:maxLines="2"
                                android:ellipsize="end"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                    </LinearLayout>
                </HorizontalScrollView>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Attachment Preview Chip above input bar -->
            <LinearLayout
                android:id="@+id/layoutAttachmentPreview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="6dp"
                android:paddingStart="8dp"
                android:paddingEnd="4dp"
                android:paddingVertical="4dp"
                android:background="@drawable/bg_suggestion_card"
                android:visibility="gone"
                app:layout_constraintBottom_toTopOf="@id/inputPillContainer"
                app:layout_constraintStart_toStartOf="parent">

                <ImageView
                    android:id="@+id/ivPreviewThumb"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_file" />

                <TextView
                    android:id="@+id/tvPreviewName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="6dp"
                    android:maxWidth="160dp"
                    android:singleLine="true"
                    android:ellipsize="middle"
                    android:text="archivo.png"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <FrameLayout
                    android:id="@+id/btnRemoveAttachment"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_circle_btn"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_close"
                        app:tint="@color/text_secondary"
                        tools:ignore="ContentDescription" />
                </FrameLayout>
            </LinearLayout>

            <!-- Floating Prompt Input Pill Bar -->
            <LinearLayout
                android:id="@+id/inputPillContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_pill_input"
                android:paddingHorizontal="8dp"
                android:paddingVertical="6dp"
                app:layout_constraintBottom_toTopOf="@id/tvDisclaimer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Plus / Attach Button -->
                <FrameLayout
                    android:id="@+id/btnAddAttachment"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_btn"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_add"
                        app:tint="@color/text_primary"
                        tools:ignore="ContentDescription" />
                </FrameLayout>

                <!-- Text Input Field -->
                <EditText
                    android:id="@+id/etPromptInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="8dp"
                    android:background="@null"
                    android:hint="@string/prompt_placeholder"
                    android:textColorHint="@color/text_hint"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:maxLines="4"
                    android:inputType="textCapSentences|textMultiLine"
                    android:importantForAutofill="no" />

                <!-- Microphone Button -->
                <FrameLayout
                    android:id="@+id/btnMic"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_mic"
                        app:tint="@color/text_secondary"
                        tools:ignore="ContentDescription" />
                </FrameLayout>

                <!-- Action Button: Sparkle / Send / Stop -->
                <FrameLayout
                    android:id="@+id/btnSend"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/ivSendIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_gemini_sparkle"
                        tools:ignore="ContentDescription" />
                </FrameLayout>
            </LinearLayout>

            <!-- Subtle Disclaimer Text -->
            <TextView
                android:id="@+id/tvDisclaimer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/disclaimer"
                android:textColor="@color/text_hint"
                android:textSize="11sp"
                android:gravity="center"
                android:layout_marginHorizontal="24dp"
                android:layout_marginBottom="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </FrameLayout>

    <!-- Side Navigation Drawer (Chat History) -->
    <LinearLayout
        android:id="@+id/navigationDrawer"
        android:layout_width="310dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@color/gemini_surface"
        android:fitsSystemWindows="true">

        <!-- Drawer Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_gemini_sparkle"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/gemini_title"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- New Chat Pill in Drawer -->
            <LinearLayout
                android:id="@+id/btnDrawerNewChat"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_chip_pill"
                android:paddingHorizontal="16dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_add"
                    app:tint="@color/text_primary"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Nuevo chat"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

        <!-- Recientes Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recientes"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="6dp" />

        <!-- Chat History List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChatHistory"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="vertical"
            android:overScrollMode="never" />

        <TextView
            android:id="@+id/tvEmptyHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No hay chats recientes"
            android:textColor="@color/text_hint"
            android:textSize="13sp"
            android:gravity="center"
            android:padding="20dp"
            android:visibility="gone" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gemini_outline" />

        <!-- Drawer Footer (Settings & Clear) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:id="@+id/btnDrawerSettings"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_suggestion_card"
                android:paddingHorizontal="14dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/text_primary"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Configuración de API"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
