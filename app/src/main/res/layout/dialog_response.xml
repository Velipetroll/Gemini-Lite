<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_sheet"
    android:padding="24dp">

    <!-- Bottom sheet drag handle indicator -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_chip_pill"
        android:backgroundTint="@color/gemini_outline" />

    <!-- Header: Prompt summary & Gemini Sparkle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_gemini_sparkle"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/tvPromptHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gemini_outline"
        android:layout_marginVertical="14dp" />

    <!-- Loading Spinner & Shimmering status -->
    <LinearLayout
        android:id="@+id/layoutLoading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="16dp">

        <ProgressBar
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:indeterminateTint="@color/gemini_blue" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pensando..."
            android:textColor="@color/text_hint"
            android:textSize="14sp"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <!-- Response Text ScrollView -->
    <ScrollView
        android:id="@+id/scrollResponse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="420dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvResponseContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp"
            android:textIsSelectable="true" />
    </ScrollView>

    <!-- Close Button -->
    <Button
        android:id="@+id/btnCloseResponse"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Cerrar"
        android:textColor="@color/text_primary"
        android:background="@drawable/bg_chip_pill"
        android:layout_marginTop="20dp" />

</LinearLayout>
