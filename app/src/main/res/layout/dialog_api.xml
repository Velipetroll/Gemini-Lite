<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_sheet"
    android:overScrollMode="never">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="18dp"
    android:paddingBottom="32dp">

    <!-- Bottom sheet drag handle indicator -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_chip_pill"
        android:backgroundTint="@color/gemini_outline" />

    <!-- API Key Input Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/api_key_label"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_suggestion_card"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp">

        <EditText
            android:id="@+id/etApiKeyInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/api_key_hint"
            android:textColorHint="@color/text_hint"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:inputType="textPassword"
            android:importantForAutofill="no"
            android:maxLines="1" />

        <!-- Toggle Visibility Button -->
        <ImageButton
            android:id="@+id/btnToggleVisibility"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_edit"
            app:tint="@color/text_hint"
            tools:ignore="ContentDescription" />

        <!-- Paste Button -->
        <TextView
            android:id="@+id/btnPasteKey"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_paste"
            android:textColor="@color/gemini_blue"
            android:textSize="13sp"
            android:textStyle="bold"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Get Key Free Link -->
    <TextView
        android:id="@+id/tvGetApiKeyLink"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/link_get_api_key"
        android:textColor="@color/gemini_cyan"
        android:textSize="12sp"
        android:layout_marginTop="6dp"
        android:clickable="true"
        android:focusable="true" />

    <!-- Test Connection & Status Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTestKey"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_test_connection"
            android:textColor="@color/text_primary"
            app:strokeColor="@color/gemini_outline"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/pbTesting"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="12dp"
            android:indeterminateTint="@color/gemini_blue"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvTestStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Default Model & Thinking Level Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/default_model_title"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_suggestion_card"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/tvDefaultModelHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/default_model_desc"
            android:textColor="@color/text_hint"
            android:textSize="11sp"
            android:layout_marginBottom="4dp" />

        <RadioGroup
            android:id="@+id/rgDefaultModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbDefaultModel35Lite"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="3.5 Flash Lite"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                app:buttonTint="@color/gemini_blue" />

            <RadioButton
                android:id="@+id/rbDefaultModel38Flash"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="3.8 Flash"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                app:buttonTint="@color/gemini_blue" />
        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="4dp"
            android:background="@color/gemini_outline" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/thinking_level_title"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="2dp" />

        <RadioGroup
            android:id="@+id/rgDefaultThinking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbDefaultThinkingHigh"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.95"
                android:text="High"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:buttonTint="@color/gemini_blue" />

            <RadioButton
                android:id="@+id/rbDefaultThinkingMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.25"
                android:text="Medium"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:buttonTint="@color/gemini_blue" />

            <RadioButton
                android:id="@+id/rbDefaultThinkingLow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.80"
                android:text="Low"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:buttonTint="@color/gemini_blue" />

            <RadioButton
                android:id="@+id/rbDefaultThinkingMinimal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.10"
                android:text="Minimal"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:buttonTint="@color/gemini_blue" />
        </RadioGroup>
    </LinearLayout>

    <!-- Web Search Grounding Switch -->
    <LinearLayout
        android:id="@+id/rowWebSearchToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_suggestion_card"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/web_search_Realtime_title"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/web_search_Realtime_desc"
                android:textColor="@color/text_hint"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchWebSearch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true" />
    </LinearLayout>

    <!-- Custom System Prompt Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/custom_instructions_title"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/etSystemPromptInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_suggestion_card"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:hint="@string/custom_instructions_hint"
        android:textColorHint="@color/text_hint"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:minLines="2"
        android:maxLines="4"
        android:gravity="top|start"
        android:inputType="textCapSentences|textMultiLine"
        android:importantForAutofill="no" />

    <!-- Save Button -->
    <Button
        android:id="@+id/btnSaveSettings"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/btn_save"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:background="@drawable/bg_button_gradient"
        android:layout_marginTop="16dp" />

</LinearLayout>
</ScrollView>
